# Copy this file to .env and adjust for your machine.
# Comma-separated list of extra frontend origins allowed to call this API
# (localhost:5173/4173 are already allowed by default). Add your teammate's
# actual Vite dev URL here, e.g. their LAN IP:
FRONTEND_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=commerceiq-ai
DATABASE_URL=sqlite:///./ecommerce.db
# Supabase Postgres (use the connection string from Project Settings > Database).
# Ensure the password is URL-encoded and SSL is required for hosted connections.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Local image files are used by default. Set to supabase in the cloud environment.
IMAGE_STORAGE_BACKEND=local
SEED_DATA_ON_EMPTY=true
SUPABASE_URL=https://ckgebhtlrqfjvhsxlhxb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
